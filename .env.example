DATABASE_URL="postgresql://user:password@localhost:5432/community_wellness_point"
SESSION_SECRET="replace-with-a-32-char-minimum-random-string"
# 64 hex characters (32 bytes) — used to AES-256-GCM encrypt TOTP secrets at
# rest. Generate with: openssl rand -hex 32
# Required — the MFA enroll/verify routes throw at startup without it, which
# locks every user out of login since MFA is mandatory. Must be set before
# deploying, not after.
ENCRYPTION_KEY="replace-with-64-hex-characters-32-bytes-generated-via-openssl-rand-hex-32"
